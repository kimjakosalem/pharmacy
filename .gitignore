# Business data. The product CSV exports carry a `cost` column, so publishing these would put
# supplier costs and margins on the public internet. Database snapshots belong in the separate
# PRIVATE pharmacy-backups repo, never here.
data/
*.csv
pharmacy_products_backup_*.json

# Local scratch / editor duplicates ("index - Copy.html" is a stale 348K clone of the whole app —
